# ---------------------------------------------------------------------------
# 西语 YouTube 学习助手 —— 环境变量示例
#
# 用法：复制本文件为 .env（已在 .gitignore 中排除，不会被提交），按需修改。
#       服务启动时会自动读取项目根目录的 .env；已存在的环境变量优先。
#
# 安全约定：任何密钥只放在环境变量或 .env 里，绝不写进代码、绝不提交进仓库。
# ---------------------------------------------------------------------------

# ---- Web 服务 -------------------------------------------------------------
# 监听地址与端口（默认 127.0.0.1:5000，只在本机可见，最安全）
SES_HOST=127.0.0.1
SES_PORT=5000
# 是否开启 Flask 调试模式（0/1）
SES_DEBUG=0
# 打开页面时预填的链接与等级（可选）
SES_DEFAULT_URL=https://www.youtube.com/watch?v=rKhPeDyKJ1g&t=123s
SES_DEFAULT_LEVEL=B1

# ---- 字幕抓取 -------------------------------------------------------------
# 可选：抓取 YouTube 字幕使用的 HTTP(S) 代理。
# 仅在云服务器等 IP 被 YouTube 限制的环境下需要；本地运行通常留空即可。
# YT_PROXY_URL=http://127.0.0.1:7890

# ---- 可选：大模型（不配置则使用离线模式） ----------------------------------
# 三项全部配置后，非示例视频的整句翻译会调用大模型；缺任何一项都回退离线逐词直译。
# 支持 OpenAI 兼容接口（/chat/completions）。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=在这里填你的密钥
# LLM_MODEL=gpt-4o-mini
# 单句请求超时（秒）。偶发限流（429）或服务端错误会自动退避重试（最多 3 次尝试）。
# LLM_TIMEOUT=30
# 并发翻译线程数（默认 4）。供应商限流严格时可调低为 1-2。
# LLM_CONCURRENCY=4
# 可选：完全自定义系统提示词（默认提示词见 core/providers/llm.py）
# LLM_SYSTEM_PROMPT=
